# Used by docker-compose.yml (copy to `.env` next to it to override the defaults).
# Local non-Docker development uses server/.env instead (see server/.env.example).

# Port on your machine where the web UI will be available: http://localhost:8080
WEB_PORT=8080

# Port on your machine for the Express API (optional direct access, e.g. curl): http://localhost:5000
API_PORT=5000
