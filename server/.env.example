# Copy to `.env` and adjust. Every value has a sensible default (see src/config.js).

# Port the Express API listens on
PORT=5000

# MongoDB connection string. Local install: mongodb://127.0.0.1:27017/upi_fraud
# Docker Compose overrides this with mongodb://mongo:27017/upi_fraud
MONGODB_URI=mongodb://127.0.0.1:27017/upi_fraud

# Base URL of the Python detection service (Flask)
DETECTION_URL=http://127.0.0.1:5001

# Allowed browser origin(s) for CORS, comma separated. The Vite dev server runs on 5173.
CORS_ORIGIN=http://localhost:5173

# How long (ms) Express waits for the detection service before giving up.
# One million transactions + 5-fold cross-validation takes roughly 1-2 minutes on a laptop; keep generous headroom.
DETECTION_TIMEOUT_MS=900000

# Largest accepted upload in megabytes
MAX_UPLOAD_MB=50

# "development" prints verbose errors in logs; "production" is quieter
NODE_ENV=development
